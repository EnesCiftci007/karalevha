{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Karalevha.API", "--launch-profile", "http"],
      "port": 5114
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "karalevha-client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-yan-port",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Karalevha.API", "--launch-profile", "http", "--urls", "http://localhost:5115"],
      "port": 5115,
      "autoPort": false
    },
    {
      "name": "client-yan-port",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "karalevha-client", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "VITE_API_URL": "http://localhost:5115" },
      "port": 5174,
      "autoPort": false
    }
  ]
}
