{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://karalevha.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://karalevha.onrender.com/uploads/:path*" },
    { "source": "/chathub", "destination": "https://karalevha.onrender.com/chathub" },
    { "source": "/chathub/:path*", "destination": "https://karalevha.onrender.com/chathub/:path*" },
    { "source": "/notificationhub", "destination": "https://karalevha.onrender.com/notificationhub" },
    { "source": "/notificationhub/:path*", "destination": "https://karalevha.onrender.com/notificationhub/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
